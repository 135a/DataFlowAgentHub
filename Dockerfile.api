# Build Go control plane API
FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY . .
ENV GOTOOLCHAIN=local
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/hub-api ./cmd/api

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=build /out/hub-api /app/hub-api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/hub-api"]
